{
  "name": "drift-cuda",
  "build": {
    "dockerfile": "../container/ubuntu24-cuda13/Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--gpus=all"
  ],
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/drift,type=bind",
  // Uncomment to work on a sibling cuda-rust checkout in the same container.
  // "mounts": ["source=${localEnv:CUDA_RUST_PATH:../cuda-rust},target=/workspaces/cuda-rust,type=bind"],
  "containerEnv": {
    "NVIDIA_DRIVER_CAPABILITIES": "all"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/drift-venv/bin/python"
      }
    }
  }
}
